# Copy to `.env` (same directory) and edit. `az login` first; auth is
# DefaultAzureCredential / Managed Identity, no API keys here.
#
# Loaded by `python-dotenv` in three places: agent boot (__main__),
# scripts/dev_run.py, scripts/smoke_calendar.py. `override=False` —
# values already in the process environment win.

# --- required at boot ---
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4
FOUNDRY_PROJECT_ENDPOINT=https://ocvp-agent-svc-resource.services.ai.azure.com/api/projects/ocvp-agent-svc
TOOLBOX_NAME=Charter-Agent-Tools

# --- optional ---
# Pin a Toolbox version in dev; omit in prod to use the consumer endpoint.
TOOLBOX_VERSION=1
# Phase 1 demo session key. BFF normally sets this per-request from /p/{project_id}.
FOUNDRY_AGENT_SESSION_ID=demo-project
