# Agent configuration
# Copy this file to .env (same directory) and edit.
# Run `az login` first — auth uses DefaultAzureCredential / Managed Identity, no API keys.
# Loaded by python-dotenv at agent boot, dev_run.py, and smoke_calendar.py.
# Values already in the process environment take precedence (override=False).

# ── Azure AI Foundry (required) ───────────────────────────────────────────────

# Model deployment name in your Azure AI Foundry project.
AZURE_AI_MODEL_DEPLOYMENT_NAME=<your-deployment-name>

# Azure AI Foundry project endpoint.
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>

# WorkIQ MCP toolbox name registered in Foundry.
TOOLBOX_NAME=Charter-Agent-Tools

# ── Deployment (required by scripts/deploy.py) ────────────────────────────────

# Entra tenant containing the Foundry project. Used by deploy.py to scope
# `az login` / AzureCliCredential to the right directory.
AZURE_TENANT_ID=<your-tenant-guid>

# Azure subscription containing the Foundry resource. Used by deploy.py
# to run `az account set` before calling the management plane.
AZURE_SUBSCRIPTION_ID=<your-subscription-guid>

# ── Optional ──────────────────────────────────────────────────────────────────

# Pin a toolbox version in dev; omit in prod to use the consumer endpoint.
# TOOLBOX_VERSION=1

# Agent name used when deploying or auto-constructing endpoint URLs (default: charter-agent).
# AGENT_NAME=charter-agent

# Container image reference used by scripts/deploy.py.
# AGENT_IMAGE=<registry>.azurecr.io/charter-agent:<tag>

# Phase 1 / local dev session key. The BFF normally sets this per-request
# from /p/{project_id}; set here only when testing the agent directly.
# FOUNDRY_AGENT_SESSION_ID=demo-project

# ── Observability ─────────────────────────────────────────────────────────────

# Set to "true" to enable Azure AI generative tracing via AIProjectInstrumentor.
# AZURE_EXPERIMENTAL_ENABLE_GENAI_TRACING=true

# ── Development ───────────────────────────────────────────────────────────────

# Override the skills directory (default: agent/skills/).
# CHARTER_AGENT_SKILLS_DIR=/path/to/skills
