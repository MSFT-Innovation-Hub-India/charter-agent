# Desktop client configuration
# Copy this file to .env and fill in your values.
# Shell environment variables always take precedence over values in this file.

# ── Agent endpoint ────────────────────────────────────────────────────────────

# "hosted" to talk to an Azure AI Foundry deployment; "local" for a dev server
# started with `python -m charter_agent`.  Default: hosted
# AGENT_ENDPOINT_MODE=hosted

# Hosted agent URL — set this explicitly, or leave blank and the client will
# auto-derive it from FOUNDRY_PROJECT_ENDPOINT + AGENT_NAME below.
# AGENT_ENDPOINT_HOSTED=https://<resource>.services.ai.azure.com/api/projects/<project>/agents/charter-agent/endpoint/protocols/openai/responses?api-version=v1

# Azure AI Foundry project endpoint used to auto-build the hosted URL.
# FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>

# Agent name registered in Foundry (default: charter-agent).
# AGENT_NAME=charter-agent

# Local dev server URL (default: http://localhost:8000).
# AGENT_ENDPOINT_LOCAL=http://localhost:8000

# ── Auth ──────────────────────────────────────────────────────────────────────

# Entra tenant ID for MSAL token acquisition.
# Leave blank to discover the tenant from the signed-in user's account.
# SPIKE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Background poller ─────────────────────────────────────────────────────────

# How often the background poller checks for new replies (minutes, default 30).
# Set to a low value for testing; restore to 30 for production.
CHARTER_POLL_INTERVAL_MINS=30

# Uncomment to restrict background polling to Mon-Fri 07:00-20:00 local time.
# CHARTER_POLL_BIZ_HOURS_ONLY=1

# ── Advanced ──────────────────────────────────────────────────────────────────

# Override the directory used for agent session state (local mode only).
# AGENT_HOME=/path/to/.charter-agent-home

# Pin the project ID when starting a fresh local session.
# AGENT_PROJECT_ID=my-project-001
